# Keep the dist archive to what a consumer actually runs: src/, data/,
# config/, composer.json, README and LICENSE.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/example            export-ignore
/test               export-ignore
/phpunit.xml        export-ignore
# Only this repository's own CI and contributors resolve against the lock
# file; a consumer's own lock is what governs their install.
/composer.lock      export-ignore
